# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Sitenin canlı adresi (e-posta doğrulama yönlendirmesi için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sesli sipariş asistanı (Google Gemini Live) — SADECE sunucuda kullanılır, tarayıcıya gitmez
GEMINI_API_KEY=

# Sipariş bildirimi e-postası (resend.com)
RESEND_API_KEY=
# İsteğe bağlı: doğrulanmış alan adıyla gönderici, ör. "Sanal Market <siparis@alanadin.com>"
NOTIFY_FROM=

# Anlık WhatsApp bildirimi (Meta WhatsApp Cloud API) — docs/WHATSAPP_CLOUD_API.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=yeni_siparis
WHATSAPP_TEMPLATE_LANG=tr
WHATSAPP_USE_TEMPLATE=
